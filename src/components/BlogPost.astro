---
const { title, pubDate, description, url } = Astro.props;
---

<article class="blog-post slide-in">
  <time class="post-date">{new Date(pubDate).toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'short', 
    day: 'numeric' 
  })}</time>
  <h3 class="post-title">
    <a href={url}>{title}</a>
  </h3>
  <p class="post-description">{description}</p>
</article>

<style>
  .blog-post {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .blog-post:last-child {
    border-bottom: none;
  }

  .post-date {
    font-size: 0.875rem;
    color: var(--text-secondary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .post-title {
    margin-bottom: 0.5rem;
  }

  .post-title a {
    color: var(--text);
    transition: color 0.2s ease;
  }

  .post-title a:hover {
    color: var(--accent);
  }

  .post-description {
    color: var(--text-secondary);
    margin-bottom: 0;
  }
</style>