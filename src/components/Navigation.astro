---
const currentPath = Astro.url.pathname;
---

<nav class="nav fade-in">
  <div class="nav-content">
    <a href="/" class="logo">Umair Mazhar</a>
    <div class="nav-links">
      <a href="/" class="nav-link" class:list={{"active": currentPath === "/"}}>Home</a>
      <!-- <a href="/about" class="nav-link" class:list={{"active": currentPath === "/about"}}>About</a> -->
      <a href="/blog" class="nav-link" class:list={{"active": currentPath.startsWith("/blog")}}>Blog</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    margin-bottom: 3rem;
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text);
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .nav-link.active {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .nav-content {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>